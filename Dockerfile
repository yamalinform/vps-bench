# Образ vpsbench — ВЕСЬ инструмент: и измерители, и движок.
#
# Постановка владельца: контейнерный вариант берётся ради того, чтобы «не лезть
# в машину практически вообще». Поэтому на хосте не остаётся ни пакетов измерителей,
# ни каталога с кодом — только Docker, образ и каталог с отчётами.
#
# Замер «контейнер против нативного» на двух площадках показал ноль значимых различий
# по ~38 метрикам — container-vs-native-2026-08-31.md.
#
# Почему именно этот набор измерителей — candidates.md §8. Коротко:
#   openssl      A3: симметричная криптография, X25519, ML-KEM-768, TLS-рукопожатия
#   sysbench     A2, A4: процессор и память вторым независимым профилем нагрузки
#   mbw          A4: копирование памяти
#   p7zip-full   A2: сжатие как общая нагрузка на процессор
#   fio          A5: диск — перцентили и глубины очереди, замены нет
#   ioping       A5: задержка и операции поиска
#   iperf3       A6: пропускная способность
#   irtt         A6: задержка, джиттер, потери
#   mtr-tiny     A6: маршрут
#   socat        A6: TLS-плечо — та же скорость через терминатор
#   sysstat      B2: %steal и условия прогона (mpstat)
#   lshw, dmidecode, virt-what, smartmontools   A1: железо и гипервизор
#   python3      сборка паспорта прямо в контейнере (В-5)
#   curl         A7: публичные точки замера скорости (В-15)
FROM debian:13-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl sysstat sysbench mbw p7zip-full fio ioping iperf3 irtt mtr-tiny socat \
      lshw dmidecode virt-what smartmontools python3 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ⚠ Движок кладётся ПОСЛЕДНИМ слоем намеренно: базовый слой с измерителями (184 МБ)
# не пересобирается и не перевыкладывается при правке кода — уходит только изменившийся
# слой в сотню килобайт. Иначе каждая правка скрипта стоила бы полной выкладки образа.
# ⚠ cpudb.py обязателен: его импортируют и assemble.py, и dashboard/build.py.
# Без него сборка отчёта падает с ModuleNotFoundError уже ПОСЛЕ замера, когда
# переигрывать поздно (проверено 31.08.2026 — первая сборка образа была именно такой).
COPY assemble.py registry.py cpudb.py /opt/vpsbench/
COPY dashboard/ /opt/vpsbench/dashboard/
COPY tool/ /opt/vpsbench/tool/

# tool/deps/ (43 МБ офлайновых .deb) в образ НЕ попадает: запасного пути доставки
# больше нет (В-12), измерители уже здесь. Исключение задано в .dockerignore.

RUN chmod +x /opt/vpsbench/tool/vpsbench.sh /opt/vpsbench/tool/agent/*.sh

# Точки входа нет намеренно: контейнер запускается с явной командой, потому что
# режимов несколько — батарея, приёмная сторона, снятие. Что именно запускать,
# решает run.sh на хосте.
#   bash /opt/vpsbench/tool/vpsbench.sh --outdir /out …
